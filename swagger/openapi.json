{
  "openapi": "3.0.3",
  "info": {
    "title": "Object Store App API",
    "version": "1.1.0",
    "description": "Storage API for object-store operations implemented by the local mock and provider-backed router."
  },
  "servers": [
    {
      "url": "/",
      "description": "Server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Bearer token used by the local mock security layer."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed request payload or missing required parameter."
      },
      "Unauthorized": {
        "description": "Missing or invalid authorization token."
      },
      "NotFound": {
        "description": "Requested item or upload session was not found."
      }
    },
    "schemas": {
      "StorageItemResponseModel": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "Success"
          },
          "provisionedPath": {
            "type": "string",
            "example": "I-1/Inbox"
          },
          "name": {
            "type": "string",
            "example": "Inbox"
          },
          "location": {
            "type": "string",
            "example": "I-1/Inbox"
          },
          "isDirectory": {
            "type": "boolean",
            "example": true
          },
          "sizeInBytes": {
            "type": "integer",
            "example": 0
          },
          "storageType": {
            "type": "string",
            "example": "Local"
          }
        }
      },
      "StorageListResponseModel": {
        "type": "object",
        "properties": {
          "bucket": {
            "type": "string",
            "example": "I-1"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Inbox/report.txt"
                },
                "sizeInBytes": {
                  "type": "integer",
                  "example": 1234
                },
                "location": {
                  "type": "string",
                  "example": "Inbox/report.txt"
                },
                "isDirectory": {
                  "type": "boolean",
                  "example": false
                },
                "storageType": {
                  "type": "string",
                  "example": "LocalMockProvider"
                },
                "creationDate": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "recursive": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "PendingUpload": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "Started"
          },
          "fileName": {
            "type": "string",
            "example": "orders.csv"
          },
          "path": {
            "type": "string",
            "example": "C:/tmp/upload-uuid"
          }
        }
      },
      "StorageLocalFileInfo": {
        "type": "object",
        "properties": {
          "fileName": {
            "type": "string",
            "example": "demo.txt"
          },
          "path": {
            "type": "string",
            "example": "C:/tmp/upload-uuid"
          },
          "status": {
            "type": "string",
            "example": "Started"
          }
        }
      },
      "ChunkType": {
        "type": "string",
        "enum": [
          "Line",
          "Binary",
          "None"
        ]
      }
    }
  },
  "paths": {
    "/Storage/{destinationName}/createPath": {
      "post": {
        "summary": "Create a folder path under the requested destination.",
        "operationId": "createPath",
        "parameters": [
          {
            "name": "destinationName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageItemResponseModel"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/Storage/{destinationName}/list": {
      "get": {
        "summary": "List files and folders for the destination and optional subfolder.",
        "operationId": "listFiles",
        "parameters": [
          {
            "name": "destinationName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "StartIn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Recursive",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageListResponseModel"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/Storage/{destinationName}/getChunk": {
      "get": {
        "summary": "Read a chunk or line range from a file under the destination.",
        "operationId": "getChunk",
        "parameters": [
          {
            "name": "destinationName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "chunkType",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ChunkType"
            }
          },
          {
            "name": "chunkSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0
            }
          },
          {
            "name": "chunkPart",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0
            }
          },
          {
            "name": "startLine",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/Storage/{destinationName}/copy": {
      "post": {
        "summary": "Create a copy of a file at sourcePath to destinationPath.",
        "operationId": "copyFile",
        "parameters": [
          {
            "name": "destinationName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sourcePath",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "destinationPath",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/Storage/{destinationName}/move": {
      "post": {
        "summary": "Move a file from sourcePath to destinationPath.",
        "operationId": "moveFile",
        "parameters": [
          {
            "name": "destinationName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sourcePath",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "destinationPath",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/Storage/{destinationName}/get": {
      "get": {
        "summary": "Download a file from the destination.",
        "operationId": "getFile",
        "parameters": [
          {
            "name": "destinationName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/Storage/{destinationName}/post": {
      "post": {
        "summary": "Upload a file to a destination path.",
        "operationId": "postFile",
        "parameters": [
          {
            "name": "destinationName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/Storage/{destinationName}/postasync": {
      "post": {
        "summary": "Upload a file asynchronously to a destination path.",
        "operationId": "postFileAsync",
        "parameters": [
          {
            "name": "destinationName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/Storage/{destinationName}/delete": {
      "delete": {
        "summary": "Delete a file from the destination.",
        "operationId": "deleteFile",
        "parameters": [
          {
            "name": "destinationName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/Storage/{destinationName}/setStorage": {
      "post": {
        "summary": "Set storage metadata on a file path.",
        "operationId": "setStorage",
        "parameters": [
          {
            "name": "destinationName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "storage",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "Archive"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/Storage/listWritable": {
      "get": {
        "summary": "List pending writable upload files.",
        "operationId": "listWritable",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StorageLocalFileInfo"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/Storage/getWritable/{fileName}": {
      "get": {
        "summary": "Get all or a portion of a writable file by fileName.",
        "operationId": "getWritable",
        "parameters": [
          {
            "name": "fileName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "chunkType",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ChunkType"
            }
          },
          {
            "name": "startLine",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0
            }
          },
          {
            "name": "chunkSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0
            }
          },
          {
            "name": "chunkPart",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/Storage/writeStart/{fileName}": {
      "post": {
        "summary": "Create a writable upload session and save the request body as the file contents.",
        "operationId": "writeStart",
        "parameters": [
          {
            "name": "fileName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "uploadId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "type": "string",
                      "example": "Started"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/Storage/writeChunk/{fileName}": {
      "post": {
        "summary": "Append a chunk to an existing writable file.",
        "operationId": "writeChunk",
        "parameters": [
          {
            "name": "fileName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "Appended"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/Storage/writeComplete/{fileName}": {
      "post": {
        "summary": "Complete the writable upload and move the temporary file to its destination.",
        "operationId": "writeComplete",
        "parameters": [
          {
            "name": "fileName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "destination",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "storagePath",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "Success"
                    },
                    "remotePath": {
                      "type": "string",
                      "example": "I-1/Inbox/orders.csv"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/Storage/writeCancel/{fileName}": {
      "post": {
        "summary": "Cancel a writable upload and remove the temporary file.",
        "operationId": "writeCancel",
        "parameters": [
          {
            "name": "fileName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "Cancelled"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/Storage/uploadStatus/{uploadId}": {
      "get": {
        "summary": "Get the status of a pending upload session.",
        "operationId": "uploadStatus",
        "parameters": [
          {
            "name": "uploadId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PendingUpload"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  }
}