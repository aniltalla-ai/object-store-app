{
  "openapi": "3.0.3",
  "info": {
    "title": "Object Store Service APIs",
    "description": "REST API service for object storage (AWS S3, Azure Blob, GCP Storage) with multi-instance tenant scoping",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Object Store Service Base Path"
    }
  ],
  "security": [
    {
      "OAuth2ClientCredentials": []
    }
  ],
  "paths": {
    "/Storage/list": {
      "get": {
        "tags": [
          "Storage"
        ],
        "summary": "List files and folders in object store without destination in path",
        "parameters": [
          {
            "name": "StartIn",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Subfolder prefix to search inside"
          },
          {
            "name": "Recursive",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Recursive listing flag"
          }
        ],
        "responses": {
          "200": {
            "description": "File listing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageListResponseModel"
                }
              }
            }
          },
          "400": {
            "description": "Missing instance parameter"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/Storage/createPath": {
      "post": {
        "tags": [
          "Storage"
        ],
        "summary": "Create directory path in object store",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Folder path to create"
          }
        ],
        "responses": {
          "200": {
            "description": "Folder created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageItemResponseModel"
                }
              }
            }
          },
          "400": {
            "description": "Missing parameters"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Security instance mismatch"
          }
        }
      }
    },
    "/Storage/get": {
      "get": {
        "tags": [
          "Storage"
        ],
        "summary": "Download file from destination",
        "parameters": [
          {
            "name": "location",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Relative file path"
          }
        ],
        "responses": {
          "200": {
            "description": "Binary file content stream",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Missing location"
          },
          "404": {
            "description": "File not found"
          }
        }
      }
    },
    "/Storage/getChunk": {
      "get": {
        "tags": [
          "Storage"
        ],
        "summary": "Get file chunk from destination",
        "parameters": [
          {
            "name": "location",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "chunkType",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ChunkType"
            }
          },
          {
            "name": "chunkSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "chunkPart",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "startLine",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Binary chunk content",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/Storage/post": {
      "post": {
        "tags": [
          "Storage"
        ],
        "summary": "Upload file synchronously to destination",
        "parameters": [
          {
            "name": "location",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "File data / content",
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "text/plain": {
              "schema": {
                "type": "string"
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Upload success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageItemResponseModel"
                }
              }
            }
          }
        }
      }
    },
    "/Storage/postasync": {
      "post": {
        "tags": [
          "Storage"
        ],
        "summary": "Upload file asynchronously to destination",
        "parameters": [
          {
            "name": "location",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "File content",
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "text/plain": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted"
          }
        }
      }
    },
    "/Storage/copy": {
      "post": {
        "tags": [
          "Storage"
        ],
        "summary": "Copy file from source path to destination path",
        "parameters": [
          {
            "name": "sourcePath",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "destinationPath",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File copied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageItemResponseModel"
                }
              }
            }
          }
        }
      }
    },
    "/Storage/move": {
      "post": {
        "tags": [
          "Storage"
        ],
        "summary": "Move file from source path to destination path",
        "parameters": [
          {
            "name": "sourcePath",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "destinationPath",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File moved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageItemResponseModel"
                }
              }
            }
          }
        }
      }
    },
    "/Storage/delete": {
      "delete": {
        "tags": [
          "Storage"
        ],
        "summary": "Delete file from destination",
        "parameters": [
          {
            "name": "location",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File deleted"
          }
        }
      }
    },
    "/Storage/listWritable": {
      "get": {
        "tags": [
          "Storage"
        ],
        "summary": "List pending files available for writing/appending",
        "responses": {
          "200": {
            "description": "List of writable files",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StorageLocalFileInfo"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/Storage/getWritable/{fileName}": {
      "get": {
        "tags": [
          "Storage"
        ],
        "summary": "Get all or a portion of a writable file",
        "parameters": [
          {
            "name": "fileName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "chunkType",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ChunkType"
            }
          },
          {
            "name": "startLine",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0
            }
          },
          {
            "name": "chunkSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0
            }
          },
          {
            "name": "chunkPart",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Writable file chunk content",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/Storage/writeStart/{fileName}": {
      "post": {
        "tags": [
          "Storage"
        ],
        "summary": "Create a file session that can be appended to",
        "parameters": [
          {
            "name": "fileName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "encoding",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/SupportedEncodings"
            }
          },
          {
            "name": "linebreak",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/LinebreakTypes"
            }
          }
        ],
        "requestBody": {
          "description": "Initial chunk data / file content",
          "required": false,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "text/plain": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Upload session initialized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageLocalFileInfo"
                }
              }
            }
          }
        }
      }
    },
    "/Storage/writeChunk/{fileName}": {
      "post": {
        "tags": [
          "Storage"
        ],
        "summary": "Add chunk to existing writable file session",
        "parameters": [
          {
            "name": "fileName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Chunk data / file content to append",
          "required": false,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "text/plain": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chunk appended",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageLocalFileInfo"
                }
              }
            }
          }
        }
      }
    },
    "/Storage/writeComplete/{fileName}": {
      "post": {
        "tags": [
          "Storage"
        ],
        "summary": "Close writable file session and move to destination",
        "parameters": [
          {
            "name": "fileName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "destination",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "storagePath",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File upload completed and stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageItemResponseModel"
                }
              }
            }
          }
        }
      }
    },
    "/Storage/writeCancel/{fileName}": {
      "post": {
        "tags": [
          "Storage"
        ],
        "summary": "Cancel writing session and remove temporary chunks",
        "parameters": [
          {
            "name": "fileName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session cancelled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageLocalFileInfo"
                }
              }
            }
          }
        }
      }
    },
    "/Storage/uploadStatus/{uploadId}": {
      "get": {
        "tags": [
          "Storage"
        ],
        "summary": "View pending upload status",
        "parameters": [
          {
            "name": "uploadId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Upload status info",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PendingUpload"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OAuth2ClientCredentials": {
        "type": "oauth2",
        "description": "OAuth2 Client Credentials Authorization (Client ID & Secret Key)",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "AUTH_TOKEN_URL",
            "scopes": {}
          }
        }
      }
    },
    "schemas": {
      "StorageItemResponseModel": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "sizeInBytes": {
            "type": "integer",
            "format": "int64"
          },
          "location": {
            "type": "string",
            "nullable": true
          },
          "isDirectory": {
            "type": "boolean"
          },
          "storageType": {
            "type": "string",
            "nullable": true
          },
          "lineCount": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "creationDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "StorageListResponseModel": {
        "type": "object",
        "properties": {
          "bucket": {
            "type": "string",
            "nullable": true
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StorageItemResponseModel"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "StorageLocalFileInfo": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "sizeInBytes": {
            "type": "integer",
            "format": "int64"
          },
          "lineCount": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "creationDate": {
            "type": "string",
            "format": "date-time"
          },
          "updateDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PendingUpload": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fileName": {
            "type": "string",
            "nullable": true
          },
          "location": {
            "type": "string",
            "nullable": true
          },
          "destLocation": {
            "type": "string",
            "nullable": true
          },
          "tenant": {
            "type": "string",
            "nullable": true
          },
          "destinationId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/UploadStatus"
          },
          "statusMessage": {
            "type": "string",
            "nullable": true
          },
          "statusDate": {
            "type": "string",
            "format": "date-time"
          },
          "insertDate": {
            "type": "string",
            "format": "date-time"
          },
          "deleted": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "UploadStatus": {
        "type": "string",
        "enum": [
          "Pending",
          "InProgress",
          "Complete",
          "Failed"
        ]
      },
      "StorageTypes": {
        "type": "string",
        "enum": [
          "Standard",
          "Nearline",
          "Coldline",
          "Archive"
        ]
      },
      "ChunkType": {
        "type": "string",
        "enum": [
          "Line",
          "Binary",
          "None"
        ]
      },
      "SupportedEncodings": {
        "type": "string",
        "enum": [
          "Default",
          "UTF8BOM",
          "UTF8",
          "UTF16BE",
          "UTF16LE"
        ]
      },
      "LinebreakTypes": {
        "type": "string",
        "enum": [
          "Unknown",
          "WindowsStyle",
          "Windows",
          "LinuxStyle",
          "Linux"
        ]
      }
    }
  }
}